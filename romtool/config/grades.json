{
 "comment": "Grade and budget-brand options for ROMtool parts selection (romtool/romtool/grades.py). Each tier names a part family per role. The candidate lists are ANS quote history (2+ jobs) with band, ratio and interface specs filled from the description where it states them. budget_rank orders candidates by relative rank only (1 is the lowest-ranked part in the list); it is not catalog data. bands_mhz is a list of [low, high] MHz ranges; a part with no stated range is not compliant for bands it does not state. Connectors are checked against the cable family and interface, not bands. Within one grade and brand the parts prefer the pair's connector interface (N for budget Techwave, 4.3-10 otherwise); a known-other interface gets an adapter line.",
 "source": "ANS quote history candidates (grade_candidates.json, 2026-11-10); owner decisions 2026-11-10",
 "default_grade": "carrier",
 "default_budget_brand": "techwave",
 "default_bands": [
  "B12_700",
  "B5_850",
  "B2_1900",
  "B66_2100"
 ],
 "default_bands_note": "Cellular set used when the project lists no bands. A project with a system_type in public_safety_system_types also gets the autoplace public_safety_band_ids.",
 "ratio_tolerance_db": 2.0,
 "ratio_tolerance_note": "Largest ratio move, in dB, allowed to match a pair interface. If no part of the pair interface is within this of the modeled ratio, the nearest part of any interface is used and adapter lines are added. The ratio is never moved further to avoid an adapter.",
 "interface_rules": "CommScope and Commscope model numbers with the -43- or UW43 token (for example C-10-UW-43-Ai6, CMAX-O-43-UW-i53, CMAX-OUS1-UW43-I53) are 4.3-10 connector parts. The interface is set from that token, not from the description.",
 "public_safety_system_types": [
  "bda"
 ],
 "tiers": {
  "carrier": {
   "label": "Carrier grade"
  },
  "enterprise": {
   "label": "Enterprise grade"
  },
  "budget": {
   "label": "Budget"
  }
 },
 "budget_brands": {
  "techwave": {
   "label": "Techwave",
   "note": "Techwave parts where Techwave has them. Other roles fall back to the cheapest compliant part, then enterprise, then carrier."
  },
  "cheapest": {
   "label": "Cheapest compliant",
   "note": "Lowest budget_rank compliant part per role and tap ratio. Falls back to enterprise, then carrier."
  }
 },
 "selection": {
  "carrier": "Family match (carrier_match) with the most ANS jobs. A tap ratio the family does not offer uses the nearest ratio it offers; ties go to the lower ratio.",
  "enterprise": "Median budget_rank among band-compliant candidates per role and tap ratio (lower median when the count is even).",
  "cheapest": "Lowest budget_rank among band-compliant candidates per role and tap ratio.",
  "techwave": "Techwave candidate with the most ANS jobs at the exact tap ratio. No nearest-ratio substitution; a missing ratio falls back.",
  "ratio_note": "Modeled tap and coupler losses are not changed. The item keeps its modeled ratio and the note reports the part ratio used."
 },
 "carrier_match": {
  "tapper": {
   "mfr": "Microlab/FXR",
   "model_regex": "DN-\\d{2}FE"
